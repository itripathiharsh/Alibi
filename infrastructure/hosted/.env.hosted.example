# ALIBI Hosted Mode Environment Template (.env.hosted.example)
# NEVER commit real secret values to version control.
# Copy this file to .env.hosted in your secure environment and fill in production secrets.

# Core runtime mode
ALIBI_MODE=hosted
ALIBI_ENV=cloud
ALIBI_TIMEZONE=Asia/Kolkata
PORT=8000

# Database (Neon PostgreSQL with connection pooling / scale-to-zero settings)
# Example: postgresql+asyncpg://<user>:<password>@<neon-host>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/alibi?ssl=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Security & Cryptography (Generate with openssl rand -hex 32)
ALIBI_SECRET_KEY=generate-32-byte-secret-key-here
ALIBI_ENCRYPTION_KEY=generate-32-byte-encryption-key-here

# Token Lifetimes
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Web & Client Origins
ALIBI_WEB_ORIGIN=https://alibi-web.vercel.app

# Opt-in Cloud AI (Default: false per privacy contract and ADR-020)
AI_EXTERNAL_ENABLED=false

# File Storage Quota (Hosted mode limit in MB)
MAX_STORAGE_MB=250
