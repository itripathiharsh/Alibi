{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ALIBI Design Tokens",
  "version": "0.1.0",
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "30px",
      "3xl": "32px"
    },
    "fontWeights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "heavy": "800"
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "control": "8px",
    "card": "20px",
    "cardPrimary": "20px",
    "cardSecondary": "14px",
    "sheet": "24px",
    "full": "9999px"
  },
  "shadows": {
    "sm": {
      "color": "#0B2030",
      "offset": { "width": 0, "height": 1 },
      "opacity": 0.03,
      "radius": 4,
      "elevation": 1
    },
    "card": {
      "color": "#0B2030",
      "offset": { "width": 0, "height": 3 },
      "opacity": 0.04,
      "radius": 10,
      "elevation": 2
    },
    "elevated": {
      "color": "#0B2030",
      "offset": { "width": 0, "height": 6 },
      "opacity": 0.08,
      "radius": 16,
      "elevation": 4
    }
  },
  "colors": {
    "light": {
      "bg": "#FBF9F8",
      "surface": "#FFFFFF",
      "surface2": "#F4F5F7",
      "text": "#0B2030",
      "textSecondary": "#53657A",
      "textMuted": "#8A96A4",
      "border": "#E7EAF0",
      "borderSubtle": "#E7EAF0",
      "primary": "#FF741F",
      "primaryHover": "#E56314",
      "navy": "#0B2030",
      "orange": "#FF741F",
      "peach": "#FFF1E6",
      "peachLight": "#FFF8F2",
      "success": "#10B981",
      "warning": "#FF741F",
      "danger": "#DC2626",
      "category": {
        "professional": "#FF741F",
        "academic": "#2563EB",
        "personal": "#10B981",
        "learning": "#8B5CF6"
      }
    },
    "dark": {
      "bg": "#090D16",
      "surface": "#111827",
      "surface2": "#1F2937",
      "text": "#F8FAFC",
      "textSecondary": "#CBD5E1",
      "textMuted": "#94A3B8",
      "border": "#334155",
      "borderSubtle": "#334155",
      "primary": "#FF741F",
      "primaryHover": "#FF8A3D",
      "navy": "#0B2030",
      "orange": "#FF741F",
      "peach": "#2D1D16",
      "peachLight": "#221712",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "category": {
        "professional": "#FF741F",
        "academic": "#8B5CF6",
        "personal": "#22C55E",
        "learning": "#F59E0B"
      }
    }
  }
}
