# ---- ALIBI environment (copy to .env; never commit .env) ----
ALIBI_ENV=local                         # local | cloud | test
ALIBI_TIMEZONE=Asia/Kolkata
ALIBI_BASE_URL=http://localhost:8000
ALIBI_WEB_ORIGIN=http://localhost:3000

# Security — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ALIBI_SECRET_KEY=change-me
# Fernet key for encrypting provider API keys — python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ALIBI_ENCRYPTION_KEY=change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Database
POSTGRES_USER=alibi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alibi
DATABASE_URL=postgresql+asyncpg://alibi:change-me@localhost:5432/alibi

# Storage for evidence/uploads/report files
ALIBI_STORAGE_DIR=./data/storage
ALIBI_MAX_UPLOAD_MB=25

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
STT_ENGINE=faster-whisper               # faster-whisper | groq | disabled
STT_MODEL=small                          # chosen after hardware benchmark (docs/13 §6)

# Cloud AI (optional — can also be set in Settings UI, stored encrypted)
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
AI_EXTERNAL_ENABLED=false               # private by default

# Backups
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30
