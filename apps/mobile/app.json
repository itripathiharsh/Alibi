{
  "expo": {
    "name": "ALIBI",
    "slug": "alibi",
    "version": "0.2.3",
    "orientation": "portrait",
    "scheme": "alibi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon_square_transparent.png",
    "splash": {
      "image": "./assets/logo_full_light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alibi.app",
      "icon": "./assets/playstore-icon.png"
    },
    "android": {
      "package": "com.alibi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_mark.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
