{
  "openapi": "3.1.0",
  "info": {
    "title": "ALIBI",
    "description": "ALIBI - Personal productivity and adaptive planning backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Live",
        "description": "Liveness probe indicating process is responsive.",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Ready",
        "description": "Readiness probe indicating application and database dependencies are ready.",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Api Meta",
        "description": "Metadata endpoint for clients to verify connectivity and API runtime parameters.",
        "operationId": "api_meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppMetaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppMetaResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "environment",
          "mode",
          "timestamp",
          "timezone"
        ],
        "title": "AppMetaResponse"
      },
      "HealthLiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthLiveResponse"
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ready"
          },
          "database": {
            "type": "string",
            "title": "Database",
            "default": "connected"
          }
        },
        "type": "object",
        "title": "HealthReadyResponse"
      }
    }
  }
}