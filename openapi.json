              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/categories/{category_id}": {
      "patch": {
        "tags": [
          "categories"
        ],
        "summary": "Update category",
        "description": "Update custom or system category settings.",
        "operationId": "update_category_api_v1_categories__category_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "category_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Category Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "categories"
        ],
        "summary": "Delete category",
        "description": "Delete category. Fails with 409 Conflict if category is a system category (AC-M1-9).",
        "operationId": "delete_category_api_v1_categories__category_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "category_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Category Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Live",
        "description": "Liveness probe indicating process is responsive.",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Ready",
        "description": "Readiness probe indicating application and database dependencies are ready.",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Api Meta",
        "description": "Metadata endpoint for clients to verify connectivity and API runtime parameters.",
        "operationId": "api_meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppMetaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppMetaResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "environment",
          "mode",
          "timestamp",
          "timezone"
        ],
        "title": "AppMetaResponse"
      },
      "CategoryCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "sharing_class": {
            "type": "string",
            "enum": [
              "professional",
              "personal",
              "academic",
              "learning"
            ],
            "title": "Sharing Class"
          },
          "external_ai_allowed": {
            "type": "boolean",
            "title": "External Ai Allowed",
            "default": false
          },
          "color": {
            "type": "string",
            "maxLength": 20,
            "title": "Color",
            "default": "#3B82F6"
          },
          "position": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Position",
            "default": 0
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "name",
          "sharing_class"
        ],
        "title": "CategoryCreate"
      },
      "CategoryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "is_system": {
            "type": "boolean",
            "title": "Is System"
          },
          "sharing_class": {
            "type": "string",
            "title": "Sharing Class"
          },
          "external_ai_allowed": {
            "type": "boolean",
            "title": "External Ai Allowed"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "is_system",
          "sharing_class",
          "external_ai_allowed",
          "color",
          "position",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "CategoryResponse"
      },
      "CategoryUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sharing_class": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "professional",
                  "personal",
                  "academic",
                  "learning"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Sharing Class"
          },
          "external_ai_allowed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
